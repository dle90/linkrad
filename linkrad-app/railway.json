{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "node server/index.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "watchPatterns": [
      "linkrad-app/server/**",
      "linkrad-app/client/**",
      "linkrad-app/package*.json",
      "linkrad-app/railway.json"
    ]
  }
}
