{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "watchPatterns": [
      "linkrad-app/pacs/Dockerfile",
      "linkrad-app/pacs/orthanc.json",
      "linkrad-app/pacs/railway.json"
    ]
  }
}
